.custom-tab-bar {
	position: relative;
	width: 100%;
	height: 104rpx;
	padding: 10rpx 20rpx;
	box-sizing: border-box;
	display: grid;
	grid-template-columns: repeat(4, minmax(0, 1fr));
	background-color: #ffffff;
	background-repeat: no-repeat;
	background-position: center;
	background-size: 100% 100%;
	border-top: 2rpx solid #e8e0d7;
}

.custom-tab-background {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	z-index: 0;
}

.custom-tab-item {
	position: relative;
	z-index: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 6rpx;
	border-radius: 8rpx;
	font-size: 21rpx;
	font-weight: 400;
}

.custom-tab-item.active {
	font-weight: 700;
}

.custom-tab-icon {
	width: 46rpx;
	height: 46rpx;
}
