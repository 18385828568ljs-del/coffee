<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.coffee.behavior.mapper.UserBehaviorEventMapper">

    <insert id="insertUserBehaviorEvent" parameterType="UserBehaviorEvent"
        useGeneratedKeys="true" keyProperty="eventId">
        insert into t_user_behavior_event
        <trim prefix="(" suffix=")" suffixOverrides=",">
            user_id,
            event_type,
            scene,
            product_id,
            <if test="categoryId != null">category_id,</if>
            <if test="sourceId != null">source_id,</if>
            <if test="dedupKey != null and dedupKey != ''">dedup_key,</if>
            event_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            #{userId},
            #{eventType},
            #{scene},
            #{productId},
            <if test="categoryId != null">#{categoryId},</if>
            <if test="sourceId != null">#{sourceId},</if>
            <if test="dedupKey != null and dedupKey != ''">#{dedupKey},</if>
            #{eventTime}
        </trim>
    </insert>
</mapper>
