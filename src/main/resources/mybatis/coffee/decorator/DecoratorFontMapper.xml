<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.coffee.decorator.mapper.DecoratorFontMapper">
    <resultMap id="FontResourceResult" type="com.ruoyi.project.coffee.decorator.font.domain.FontResource">
        <id property="id" column="id" />
        <result property="fontCode" column="font_code" />
        <result property="fontName" column="font_name" />
        <result property="familyName" column="family_name" />
        <result property="sourceType" column="source_type" />
        <result property="merchantId" column="merchant_id" />
        <result property="storageKey" column="storage_key" />
        <result property="previewStorageKey" column="preview_storage_key" />
        <result property="mimeType" column="mime_type" />
        <result property="fontWeight" column="font_weight" />
        <result property="fontStyle" column="font_style" />
        <result property="status" column="status" />
        <result property="createdBy" column="created_by" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
    </resultMap>

    <sql id="fontColumns">
        id, font_code, font_name, family_name, source_type, merchant_id, storage_key,
        preview_storage_key, mime_type, font_weight, font_style, status, created_by, created_at, updated_at
    </sql>

    <select id="selectAvailableFonts" resultMap="FontResourceResult">
        select <include refid="fontColumns" /> from font_resources
        where status = 'ACTIVE' and (merchant_id is null or merchant_id = #{merchantId})
        order by source_type, font_name, id
    </select>

    <select id="selectUsableFonts" resultMap="FontResourceResult">
        select <include refid="fontColumns" /> from font_resources
        where id in
        <foreach item="fontId" collection="fontIds" open="(" separator="," close=")">#{fontId}</foreach>
          and status = 'ACTIVE' and (merchant_id is null or merchant_id = #{merchantId})
    </select>
</mapper>
